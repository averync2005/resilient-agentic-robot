# ---------------------------
# Cloud Agent(s) Configuration
# ---------------------------

# The LLM provider for the cloud agent
LLM_PROVIDER=

# The model name for the LLM provider
LLM_MODEL=

# API key
API_KEY=  # Google AI Studio (using free tiers)


# ---------------------------
# Edge Agent(s) Configuration
# ---------------------------

# Edge agent (all optional - defaults point at the local `gemma` llama-server container)
# EDGE_BASE_URL=http://127.0.0.1:8080/v1
# EDGE_CONTAINER_NAME=gemma
# EDGE_STARTUP_TIMEOUT=300
# EDGE_THINKING=false
# EDGE_SYSTEM_PROMPT=