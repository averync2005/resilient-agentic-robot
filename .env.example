# ---------------------------
# Cloud Agent(s) Configuration
# ---------------------------

# The LLM provider for the cloud agent
LLM_PROVIDER=

# The model name for the LLM provider
LLM_MODEL=

# API key
API_KEY=  # Google AI Studio (using free tiers)

# Edge agent connection (all optional - defaults match the direct Ethernet setup in README.md)
# CLOUD_EDGE_URL=https://192.168.10.2:8443
# CLOUD_CA_CERT=certs/ca.crt
# CLOUD_EDGE_TIMEOUT=120


# ---------------------------
# Edge Agent(s) Configuration
# ---------------------------

# Edge agent (all optional - defaults point at the local `gemma` llama-server container)
# EDGE_BASE_URL=http://127.0.0.1:8080/v1
# EDGE_CONTAINER_NAME=gemma
# EDGE_STARTUP_TIMEOUT=300
# EDGE_THINKING=false
# EDGE_SYSTEM_PROMPT=

# Edge agent A2A server (all optional - defaults match the direct Ethernet setup in README.md)
# EDGE_A2A_HOST=0.0.0.0
# EDGE_A2A_PORT=8443
# EDGE_PUBLIC_URL=https://192.168.10.2:8443
# EDGE_TLS_CERT=certs/edge.crt
# EDGE_TLS_KEY=certs/edge.key
