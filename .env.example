# ---------------------------------
# Cloud agent(s) configuration
# ---------------------------------

# The LLM provider for the cloud agent
LLM_PROVIDER=

# The model name for the LLM provider (ex. gemini-3.5-flash-lite, switch models if one returns 503 UNAVAILABLE)
LLM_MODEL=

# API key
API_KEY=  # Google AI Studio (using free tiers)

# Edge agent connection (all optional - defaults match the USB-C link setup in README.md)
# CLOUD_EDGE_URL=https://192.168.55.1:8443
# CLOUD_CA_CERT=certs/ca.crt
# CLOUD_EDGE_TIMEOUT=120


# ---------------------------------
# Edge agent(s) configuration
# ---------------------------------

# Edge agent (all optional - defaults point at the local `gemma` llama-server container)
# EDGE_BASE_URL=http://127.0.0.1:8080/v1
# EDGE_CONTAINER_NAME=gemma
# EDGE_STARTUP_TIMEOUT=300
# EDGE_THINKING=false
# EDGE_SYSTEM_PROMPT=

# Edge agent A2A server (all optional - defaults match the USB-C link setup in README.md)
# EDGE_A2A_HOST: 0.0.0.0 listens on every network, including Wi-Fi
# The server has no authentication yet, so while the Jetson is on Wi-Fi, set this to its USB-C link address (192.168.55.1)
# EDGE_A2A_HOST=0.0.0.0
# EDGE_A2A_PORT=8443
# EDGE_PUBLIC_URL=https://192.168.55.1:8443
# EDGE_TLS_CERT=certs/edge.crt
# EDGE_TLS_KEY=certs/edge.key

# Robot arm (all optional - off by default, so edge-agent-serve runs without the arm)
# EDGE_ARM_ENABLED=true turns on arm actions in edge-agent-serve (edge-agent-arm always uses the arm)
# EDGE_ARM_ENABLED=false
# EDGE_POSES_FILE=poses.yaml
# EDGE_POSE_MOVE_MS=2500
